# Vertex AI Live API configuration (server-side)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Auth — choose ONE:
# (a) Local dev: path to a service-account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# (b) Railway / containers: paste the key JSON contents directly
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Optional overrides
# LIVE_MODEL=gemini-live-2.5-flash-native-audio
# LIVE_VOICE=Puck
